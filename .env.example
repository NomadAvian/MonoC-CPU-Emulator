# monoc cpu emulator — environment config
#
# 1. copy this file:  cp .env.example .env
# 2. set your gemini api key (optional as app works without ai)
# 3. run:  ./start_monoc.sh or via docker (check hosting.md)

# --- ai api key ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- ollama ---
# 1. Local Native Usage
# OLLAMA_MODEL=qwen2.5:7b

# -- ollama and docker (optional) --
# For Scenario 2 or 3 in hosting.md 
# before starting Docker, you MUST run this command on the Model host pc
# to start Ollama (do NOT uncomment this line):
# $ env OLLAMA_HOST="0.0.0.0" ollama serve

# 2. Docker + Ollama on Same Device)
# On Mac/Windows Docker Desktop, use:
# OLLAMA_HOST=http://host.docker.internal:11434
 
# 3. Docker + Ollama on Different Devices
# On Linux or remote server via Tailscale, use the specific IP:
# OLLAMA_HOST=http://100.x.y.z:11434

