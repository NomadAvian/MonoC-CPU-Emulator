# monoc cpu emulator — environment config
#
# 1. copy this file:  cp .env.example .env
# 2. set your gemini api key (optional as app works without ai)
# 3. run:  ./start_monoc.sh   or   docker compose up -d --build

# --- ai api key ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- model selection (optional overrides) ---
# GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_MODEL=qwen2.5:7b

# ---  ollama via tailscale (very optional) ---
# on that machine run:  OLLAMA_HOST=0.0.0.0 ollama serve
# then set its tailscale ip here:
# OLLAMA_HOST=http://100.x.x.x:11434
