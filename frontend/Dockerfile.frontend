
FROM node:20-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci

ARG VITE_AI_API_URL
ARG VITE_CPU_API_URL
ENV VITE_AI_API_URL=$VITE_AI_API_URL
ENV VITE_CPU_API_URL=$VITE_CPU_API_URL

COPY . .
RUN npm run build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
