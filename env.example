# monoc cpu emulator: environment config
#
# setup:
#   1. copy this file:    cp .env.example .env
#   2. uncomment and fill in the vars for your chosen mode
#   3. full details:      docs/hosting.md
#
# all AI config is optional. the app runs without it.


# ****** gemini *********
# google's cloud API. works with any deployment mode (native or any docker profile).
# get a key at: https://aistudio.google.com/apikey
#
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash


# ****** ollama **********
# local or remote open-weight models. Choose the subcase that matches your setup.
# model to use:
# OLLAMA_MODEL=qwen2.5:7b

# --- local native ---
# ollama is auto-detected on localhost. no ollama_host needed.

# --- base profile: Ollama on the same host ---
# run ollama app natively, then point Docker at it:
# OLLAMA_HOST=http://host.docker.internal:11434

# --- base profile: Ollama on a different machine (LAN or Tailscale) ---
# On the Ollama host machine, run:
#   env OLLAMA_HOST="0.0.0.0" ollama serve
# then set the host's IP or Tailscale address here:
# OLLAMA_HOST=http://100.x.y.z:11434

# --- Ollama Profile ---
# (docker compose --profile ollama up -d)
# Ollama runs inside Docker — no OLLAMA_HOST needed. Just set OLLAMA_MODEL above.


# ******* OMNIROUTE *******
# free ai proxy across many cloud AI providers
#
# if preinstalled, Omni Profile spins up OmniRoute automatically, no key needed:
#   docker compose --profile omni up -d
#
# OMNIROUTE_API_KEY=your_omniroute_api_key_here
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_MODEL=select_your_omniroute_model
